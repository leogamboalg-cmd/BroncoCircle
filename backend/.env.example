# Copy this file to .env. Use your local MongoDB or Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
PORT=3000

# Backend only. Never place these values in frontend files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render only: route AI calls to the authenticated laptop relay.
# Keep both blank to use local Ollama directly.
AI_RELAY_URL=
AI_RELAY_TOKEN=
