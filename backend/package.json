{
  "name": "broncocircle-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BroncoCircle Express API with in-memory CPP community data",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed:matching": "node --env-file-if-exists=.env scripts/seedMatching.js",
    "test:live": "node --env-file-if-exists=.env scripts/testLiveBackend.js",
    "test:browser": "node --env-file-if-exists=.env scripts/testEventBrowser.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "ollama": "^0.6.4"
  },
  "type": "module",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
